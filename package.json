{
  "name": "auto_test",
  "version": "2.0.0",
  "description": "E2E test suite for Sauce Demo using Playwright and the Page Object Model pattern.",
  "scripts": {
    "test": "npx playwright test",
    "test:login": "npx playwright test login.spec.js",
